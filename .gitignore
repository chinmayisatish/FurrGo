# =============================================================================
# FurrGo Workspace — .gitignore
# =============================================================================

# Secrets & environment
.env
.env.*
!.env.example
nvapi*.txt
*.key
*.pem
!requirements*.txt

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# pytest & coverage
.pytest_cache/
.coverage
htmlcov/
*.xml
*.cover
coverage.json

# Databases & Vector Stores
*.db
*.sqlite
*.sqlite3
chroma_db/
tmp_chroma/
data/
uploads/

# Archives & temporary artifacts
*.zip
*.bak

# IDEs
.vscode/
.idea/
.DS_Store
Thumbs.db

