# =============================================================================
# Healthcare Monitoring Assistant — .env.example
# Copy this file to .env and fill in the values for your environment.
# =============================================================================
#
# NEVER put real secrets in this file.
# This file IS committed to version control as a reference template.
# =============================================================================

# --------------------------------------------------------------------------- #
# Application metadata
# --------------------------------------------------------------------------- #
APP_NAME="Healthcare Monitoring Assistant"
APP_VERSION="0.1.0"
DEBUG=False

# --------------------------------------------------------------------------- #
# Server settings
# --------------------------------------------------------------------------- #
HOST=127.0.0.1
PORT=8000

# --------------------------------------------------------------------------- #
# AI / LLM integration: Google Gemini (Multimodal / Document & Image Understanding)
# Obtain a free key at: https://aistudio.google.com/app/apikey
# --------------------------------------------------------------------------- #
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------------- #
# AI / LLM integration: NVIDIA Nemotron (Primary Text-Only Chat Generation)
# Obtain a key at: https://build.nvidia.com/explore/discover
# --------------------------------------------------------------------------- #
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --------------------------------------------------------------------------- #
# Database
# SQLite (local file) is default. Update for PostgreSQL in production.
# --------------------------------------------------------------------------- #
DATABASE_URL=sqlite:///./data/health_ai.db

# --------------------------------------------------------------------------- #
# File uploads
# --------------------------------------------------------------------------- #
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --------------------------------------------------------------------------- #
# External health integrations
# --------------------------------------------------------------------------- #
HEALTH_INTEGRATION_API_KEY=your-health-integration-api-key-here

# --------------------------------------------------------------------------- #
# Google Health API (OAuth)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Enable Google Health API at: https://console.cloud.google.com/apis/library/health.googleapis.com
# Configure OAuth consent screen at: https://console.cloud.google.com/auth/consent
# Add scopes at: https://console.cloud.google.com/auth/scopes
# --------------------------------------------------------------------------- #
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/fitness/google/callback

# --------------------------------------------------------------------------- #
# Token Encryption (for OAuth token secure storage)
# 32-character encryption key for Fernet
# --------------------------------------------------------------------------- #
TOKEN_ENCRYPTION_KEY=dev-secret-change-in-production-32chars!

# --------------------------------------------------------------------------- #
# RAG Embeddings & ChromaDB Vector Store
# --------------------------------------------------------------------------- #
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
CHROMA_PERSIST_DIR=./chroma_db
