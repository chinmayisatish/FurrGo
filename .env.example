# =============================================================
# FurrGo — Root .env.example
# Lists all environment variables required across all backends.
# Copy to each backend's .env file and fill in real values.
# NEVER commit real secrets — this file is a template only.
# =============================================================

# ---- Application ----
APP_NAME="FurrGo Healthcare API"
APP_VERSION="1.0.0"
DEBUG=False

# ---- Server ----
# Healthcare_Backend uses 8000, Gemini_Backend 8001, FurrGo_Healthcare 8002
HOST=127.0.0.1
PORT=8000

# ---- NVIDIA Nemotron (text-only chat) ----
# Get a free key at: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Google Gemini (image/PDF understanding — Healthcare_Backend & Gemini_Backend only) ----
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ---- Database (Healthcare_Backend & FurrGo_Healthcare) ----
DATABASE_URL=sqlite:///./data/health_ai.db

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Google Health OAuth (Healthcare_Backend only) ----
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/fitness/google/callback

# ---- Encryption (Healthcare_Backend notifications) ----
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here

# ---- External health integrations ----
HEALTH_INTEGRATION_API_KEY=your-health-integration-api-key-here
